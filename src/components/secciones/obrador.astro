---
// «El obrador»: foto a sangre a la izquierda (`imagen`) y texto a la derecha: `desde` como cifra grande en bermellón
// (el año en que se abrió; solo si el cliente lo da), antetítulo, título, `declaracion` en Yeseva One, párrafos de
// `texto` y los valores (`items` {titulo, texto}) como filas con filete. Sin foto, el texto ocupa la banda.
import { seccion, parrafos } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const desde = String(s?.desde ?? '').trim();
---

{
  s && (
    <section id={Astro.props.id} class:list={['banda', 'banda--clara', { 'banda--sin-relleno': s.imagen }]}>
      <div class:list={[s.imagen ? 'mitades mitades--foto-izq' : 'contenedor']}>
        <div class:list={[{ 'mitad-texto': s.imagen }]}>
          {desde && (
            <p class="desde">
              <span class="menuda">Desde</span>
              <span class="desde-cifra">{desde}</span>
            </p>
          )}
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} />
          {s.declaracion && <p class="declaracion">{s.declaracion}</p>}
          {parrafos(s.texto).length > 0 && <div class="parrafos">{parrafos(s.texto).map((p) => <p>{p}</p>)}</div>}
          {s.items.length > 0 && (
            <ul class="valores">
              {s.items.map((it) => (
                <li>
                  <p class="valores-titulo">{it.titulo}</p>
                  {it.texto && <p class="valores-texto">{it.texto}</p>}
                </li>
              ))}
            </ul>
          )}
          {s.cta?.url && <div class="botones"><a class="btn-sec" href={s.cta.url}>{s.cta.texto}</a></div>}
        </div>
        {s.imagen && (
          <div class="mitad-foto foto">
            <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1400} alto={1050} />
          </div>
        )}
      </div>
    </section>
  )
}
