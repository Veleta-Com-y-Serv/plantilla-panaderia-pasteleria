---
// Portada «Stage»: a la izquierda, antetítulo en letra menuda, titular en Yeseva One, una frase y los dos botones
// (píldora bermellón + subrayado de tinta); debajo, los `items` (solo `titulo`) como datos cortos separados por
// filetes de oro. A la derecha, la foto (`imagen`) a sangre hasta el borde de la ventana y de toda la altura, con
// `pie_foto` como etiqueta de papel. En móvil la foto va arriba. Sin `imagen`, la portada es solo texto.
// Sin `cta`, el primer botón llama; sin `cta_secundario`, lleva al mapa.
import { seccion, site, tel, mapa, externo } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const c = site.contacto;
const principal = s?.cta?.url ? s.cta : c.telefono ? { texto: `Llamar al ${c.telefono}`, url: tel(c.telefono) } : null;
const secundario = s?.cta_secundario?.url ? s.cta_secundario : c.direccion ? { texto: 'Cómo llegar', url: mapa(c.direccion) } : null;
const datos = (s?.items ?? []).map((it) => String(it?.titulo ?? '').trim()).filter(Boolean);
---

{
  s && (
    <section id={id} class:list={['portada', { 'portada--con-foto': s.imagen }]}>
      <div class="portada-texto">
        {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
        <h1 class="portada-titulo">{s.titulo || site.nombre}</h1>
        {s.texto && <p class="portada-parrafo">{s.texto}</p>}
        {(principal || secundario) && (
          <div class="botones">
            {principal && (
              <a class="btn" href={principal.url} {...(externo(principal.url) && { rel: 'noopener', target: '_blank' })}>
                {principal.texto}
              </a>
            )}
            {secundario && (
              <a class="btn-sec" href={secundario.url} {...(externo(secundario.url) && { rel: 'noopener', target: '_blank' })}>
                {secundario.texto}
              </a>
            )}
          </div>
        )}
        {datos.length > 0 && (
          <ul class="portada-datos menuda">
            {datos.map((d) => <li>{d}</li>)}
          </ul>
        )}
      </div>
      {s.imagen && (
        <div class="portada-foto foto">
          <Imagen src={s.imagen} alt={altHero()} ancho={1600} alto={1200} prioridad={primera} />
          {s.pie_foto && <p class="portada-pie menuda">{s.pie_foto}</p>}
        </div>
      )}
    </section>
  )
}
